# ============================================================
# Variables de entorno para producción (GCP Cloud Run / Neon)
# ============================================================

# App
JWT_SECRET=generar_string_aleatorio_32_chars
MASTER_KEY=generar_string_aleatorio_32_chars
ENV=production

# PostgreSQL / Neon
DATABASE_URL=postgresql+asyncpg://usuario:password@host/db?ssl=require

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Google OAuth (para login con Google y Gmail polling)
GOOGLE_CLIENT_ID=...
GOOGLE_IOS_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GMAIL_TOKEN_KEY=...   # Fernet key para cifrar tokens de Gmail

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+15709091218
TWILIO_OTP_CONTENT_SID=...
TWILIO_REMINDER_CONTENT_SID=...

# CORS (agregar dominio del frontend cuando esté deployado)
# CORS_ORIGINS=["https://tu-app.web.app","https://tu-app.firebaseapp.com"]
