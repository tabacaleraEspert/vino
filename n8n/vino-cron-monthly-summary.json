{
  "nodes": [
    {
      "parameters": {
        "content": "## Cron: Resumen mensual automático\nCorre el 1ro de cada mes a las 10am\nEnvía resumen del mes anterior a todos los usuarios",
        "height": 300,
        "width": 800
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [200, -300],
      "typeVersion": 1,
      "id": "note-cron",
      "name": "Note Cron"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 10,
              "triggerAtDay": 1
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [300, -100],
      "id": "cron-trigger",
      "name": "1ro de cada mes 10am"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, Nombre, WppEntero FROM dbo.MaestroUsuarios WHERE WppEntero IS NOT NULL AND WppEntero != ''"
      },
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.1,
      "position": [500, -100],
      "id": "get-users",
      "name": "Obtener usuarios con WPP",
      "credentials": {
        "microsoftSql": {
          "id": "aQ5FbnI0cRuxXSV2",
          "name": "Azure EspSa"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vino-backend-bkbge8cwfffsdrhc.brazilsouth-01.azurewebsites.net/api/v1/whatsapp/monthly-summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.id }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [720, -100],
      "id": "get-summary",
      "name": "POST /monthly-summary",
      "credentials": {
        "httpHeaderAuth": {
          "id": "Vs0QI3pE2uopgGVB",
          "name": "X-Master-Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/{{ TWILIO_ACCOUNT_SID }}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "From", "value": "whatsapp:+15709091218" },
            { "name": "To", "value": "={{ $('Obtener usuarios con WPP').item.json.WppEntero }}" },
            { "name": "Body", "value": "={{ $json.reply }}" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [960, -100],
      "id": "send-summary",
      "name": "Enviar resumen por WhatsApp",
      "credentials": {
        "httpBasicAuth": {
          "id": "qu2pUaLFWnPuyEoT",
          "name": "Twilio Template Sender"
        }
      }
    }
  ],
  "connections": {
    "1ro de cada mes 10am": {
      "main": [[{ "node": "Obtener usuarios con WPP", "type": "main", "index": 0 }]]
    },
    "Obtener usuarios con WPP": {
      "main": [[{ "node": "POST /monthly-summary", "type": "main", "index": 0 }]]
    },
    "POST /monthly-summary": {
      "main": [[{ "node": "Enviar resumen por WhatsApp", "type": "main", "index": 0 }]]
    }
  },
