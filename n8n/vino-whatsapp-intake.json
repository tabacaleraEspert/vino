      "parameters": {
        "jsCode": "// Después de transcribir, armar payload con el texto transcripto\nconst parsed = $('Parse Input').first().json;\nreturn [{\n  From: parsed.From,\n  Body: ($json.text || '').trim(),\n  WaId: parsed.WaId,\n  ButtonPayload: parsed.ButtonPayload\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, -9040],
      "id": "merge-audio",
