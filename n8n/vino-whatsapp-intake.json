    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\nreturn [{\n  From: body.From || '',\n  Body: (body.Body || '').trim(),\n  WaId: body.WaId || '',\n  ButtonPayload: body.ButtonPayload || null,\n  MessageType: body.MessageType || 'text',\n  MediaUrl0: body.MediaUrl0 || null\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, -9100],
      "id": "parse-input",
      "name": "Parse Input"
